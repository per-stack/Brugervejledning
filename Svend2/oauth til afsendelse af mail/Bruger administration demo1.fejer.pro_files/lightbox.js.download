

/*
	lightbox.js - jQuery Plugin

	AUTHOR: Andriy Slobodyan, Web-Developer, ErKi Data Aps.

	DESCRIPTION:
		*	Supports all modern browsers
		*	Works with link tags only, opens LightBoxes with the fixed Width & Height paramethers
		*	Doesn't conflicts with other libraries

	HOW TO USE:
		Step 1. Include jQuery library
		Step 2. Include lightbox.min.js Plugin
		Step 3.	Use jQuery('a').aslobodyanBox(Width,Height);
				where "Width" - LightBox Width, "Height" - LightBox height

	ADDITIONAL INFO:
		LightBox has so called autoResize Height property by default.
		If you will add parameter "false" as 3rd paramether - LightBox Height will not have autoResize property
		Example:		jQuery('a').aslobodyanBox(500,300,false);
		Explanation: 	autoResize Height property will be ignored in this example

	ATTENTION!
		This Plugin is for free, not for sale.
		You have the right to modify the plugin script and even its functionality according to your needs,
		but you have no right to modify the name of the main plugin's function (aslobodyanBox();).
		Also you have no right to change or delete the name of its author (Andriy Slobodyan) from this document.
*/
jQuery.fn.aslobodyanBox=function(w,h,autoHeight){
	var setW;
	var setH;
	var originalW,originalH;
	var pressedLink=this;
	var globalHeight;
	
	function getWindowTop()
	{				
		if( /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) ) return window.getBodyScrollTop()+5;
		return screenY()-jQuery('#asCont').height()*0.5;
	}

	jQuery(pressedLink).bind('click',function(){

		originalW=parseInt(jQuery(window).width());
		originalH=parseInt(jQuery(window).height());
		if(h>(originalH-200)) h=originalH-200;
	//	if(w>(originalW-200)) w=originalW-200;
		setW=w;
		setH=h;
		var asProtoCurrentElementHREF=jQuery(pressedLink).attr('href');

		var asCurrentElementHREF=asProtoCurrentElementHREF+"&param="+new Date().getTime();
		jQuery(this).attr('href','javascript:void(0)').addClass('asX');
		var g=jQuery('<div />',{
			id:'asBg',
			style:'height: '+jQuery(document).height()+'px'
		});
		jQuery('body').css({
			height:originalH+'px',
			overflow:'hidden',
			position:'relative'
		}).prepend(g);
		var asCont=jQuery('<div />',{
			id:'asCont',
			style:'width:'+w+'px; height:'+h+'px;'
		});
		
		jQuery('body').append('<div id="moveHandler" ></div>').append(asCont);
		asCont.focus();
		asCont.css({top:getWindowTop(),left:screenX()-jQuery('#asCont').width()*0.5}); 
		asContH='-'+jQuery('#asCont').height()*0.5+'px';
		asContW='-'+jQuery('#asCont').width()*0.5+'px';
		//jQuery('#asCont').css('margin',asContH+' 0 0 '+asContW);
		cH=getWindowTop()-18;
		cW=screenX()+parseInt(jQuery('#asCont').width())*0.5+21;
		var asClose=jQuery('<a />',{
			href:'javascript:void(0)',
			title:'',
			id:'asClose',
			style:'top: '+cH+'px; left:'+cW+'px; outline: 0 none;'
		});
		
		jQuery('#moveHandler').css({top:cH, left: cW-jQuery('#asCont').width()-37});
		
		document.getElementById('moveHandler').addEventListener('touchmove', function(event) {
		  // If there's exactly one finger inside this element
		  
		  if (event.targetTouches.length == 1) {
			event.preventDefault();
			var touch = event.targetTouches[0];
			// Place element where the finger is
			document.getElementById('moveHandler').style.left = touch.pageX + 'px';
			document.getElementById('moveHandler').style.top = touch.pageY + 'px';
			jQuery('#asCont').css({top:parseFloat(jQuery('#moveHandler').css('top').slice(0, (jQuery('#moveHandler').css('top').length-2)))+18, left: jQuery('#moveHandler').offset().left+jQuery('#asClose').width()-17});
			jQuery('#asClose').css({top:jQuery('#asCont').offset().top-jQuery('#asClose').height(), left: jQuery('#asCont').offset().left+jQuery('#asCont').width()+jQuery('#asClose').width()/2});
		  }
		}, false);
		
		
		jQuery('body').append(asClose);
		
		jQuery('#moveHandler').draggable({ cursor: "move" , drag: function( event, ui ) {
			
			jQuery('#asCont').css({top:parseFloat(jQuery('#moveHandler').css('top').slice(0, (jQuery('#moveHandler').css('top').length-2)))+18, left: jQuery('#moveHandler').offset().left+jQuery('#asClose').width()-17});
			jQuery('#asClose').css({top:jQuery('#asCont').offset().top-jQuery('#asClose').height()-23, left: jQuery('#asCont').offset().left+jQuery('#asCont').width()+jQuery('#asClose').width()/2});
		}, stop:function(){
			jQuery('#asCont').css({top:parseFloat(jQuery('#moveHandler').css('top').slice(0, (jQuery('#moveHandler').css('top').length-2)))+18, left: jQuery('#moveHandler').offset().left+jQuery('#asClose').width()-17});
			jQuery('#asClose').css({top:jQuery('#asCont').offset().top-jQuery('#asClose').height()-23, left: jQuery('#asCont').offset().left+jQuery('#asCont').width()+jQuery('#asClose').width()/2});
			
		} });
		
		if(jQuery.browser.msie) jQuery('#asBg').css('display','block');
		else jQuery('#asBg').fadeIn(300);
		jQuery(window).bind('resize',function(){
			var realW=jQuery(window).width();
			var realH=jQuery(window).height();
			if(setH&&setW){
				h=setH;
				w=setW;
				var asContH='-'+parseInt(h)*0.5+'px';
				var asContW='-'+parseInt(w)*0.5+'px';
				jQuery('#asCont').attr('style','width:'+w+'px; height:'+globalHeight+'px;');
				asCont.css({top:getWindowTop(),left:screenX()-jQuery('#asCont').width()*0.5}); 

				jQuery('#moveHandler').css({top:getWindowTop()-18, left: screenX()+parseInt(jQuery('#asCont').width())*0.5+21-jQuery('#asCont').width()-37});
				var cH=screenY()-parseInt(h)*0.5-18;
				var cW=screenX()+parseInt(w)*0.5+21;
				jQuery('#asClose').attr('style','top: '+cH+'px; left:'+cW+'px; outline: 0 none;')
			}
		});
		jQuery('#asBg').click(function(){jQuery('#asClose').click();});
		jQuery('#asCont').load(asCurrentElementHREF,function(){
			if(autoHeight==false) autoHeight=h;
			else autoHeight='auto';
			globalHeight=autoHeight;
			if(jQuery('#asCont .defaultFocus').length==0) jQuery('div#asCont').focus(); else jQuery('#asCont .defaultFocus:eq(0)').focus().each(function(){if(jQuery(this).hasClass('endStringFocus')) {this.selectionStart = this.selectionEnd = this.value.length; } });
			jQuery('div#asCont').css('height',globalHeight);
			jQuery('#asClose').click(function(){
				jQuery('#asClose').remove();
				jQuery('#moveHandler').remove();
				jQuery('#asCont').remove();
				jQuery('#asBg').remove();
				jQuery('body').removeAttr('style');
				//jQuery('body').attr('style','background:url(/img/santaseamless.png)'); //# New year background removeAttr('style') after new year
				jQuery('.asX').attr('href',asProtoCurrentElementHREF).removeClass('asX');
				jQuery(pressedLink).unbind().click(function(e){e.stopPropagation();});
				if(globalHeight==h)jQuery(pressedLink).aslobodyanBox(w,h,false);
				else jQuery(pressedLink).aslobodyanBox(w,h);
				setW=null;
				setH=null;
				autoHeight=null
				jQuery('body').unbind('keyup');
				jQuery('.defaultFocus').focus();				
				
				if(currentPage!=undefined)
				{
					if(typeof(currentPage.hashCode)=='function') 
						createCookie('pagePosition_'+currentPage.hashCode(), jQuery(window).scrollTop());
				}
			})
			jQuery('body').keyup(function(e){
				if(e.keyCode=='27') jQuery('#asClose').click();
				if(e.keyCode=='13') jQuery('#asCont').find('.defaultAction').click();
				});
			if(isIpad==true)	
			{
				jQuery('#asCont input, #asCont textarea').focus(function(){
					jQuery(window).scrollTop(jQuery(window).scrollTop() + 34);
				});
				
				jQuery('#asCont input, #asCont textarea').blur(function(){
					jQuery(window).scrollTop(jQuery(window).scrollTop() - 34);
				});
			}
		})
	})
};
/**
	function for on-demand script use of aslobodyanBox
**/
jQuery.callBox=function(w, h, href, data, autoHeight){
	function getWindowTop()
	{				
		if( /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) ) return window.getBodyScrollTop()+5;
		return screenY()-jQuery('#asCont').height()*0.5;
	}
	var setW;
	var setH;
	var originalW,originalH;	
	var globalHeight;
	
		originalW=parseInt(jQuery(window).width());
		originalH=parseInt(jQuery(window).height());
		if(h>(originalH-200)) h=originalH-200;
		if(w>(originalW-200)) w=originalW-200;
		setW=w;
		setH=h;
		
		var g=jQuery('<div />',{
			id:'asBg',
			style:'height: '+jQuery(document).height()+'px'
		});
		jQuery('body').css({
			height:originalH+'px',
			overflow:'hidden',
			position:'relative'
		}).prepend(g);
		var asCont=jQuery('<div />',{
			id:'asCont',
			style:'width:'+w+'px; height:'+h+'px;'
		});

		jQuery('body').append('<div id="moveHandler" ></div>').append(asCont);
		asCont.focus();
		asCont.css({top:getWindowTop(),left:screenX()-jQuery('#asCont').width()*0.5}); 
		asContH='-'+jQuery('#asCont').height()*0.5+'px';
		asContW='-'+jQuery('#asCont').width()*0.5+'px';
		//jQuery('#asCont').css('margin',asContH+' 0 0 '+asContW);
		cH=getWindowTop()-18;
		cW=screenX()+parseInt(jQuery('#asCont').width())*0.5+21;
		var asClose=jQuery('<a />',{
			href:'javascript:void(0)',
			title:'',
			id:'asClose',
			style:'top: '+cH+'px; left:'+cW+'px; outline: 0 none;'
		});
		jQuery('#moveHandler').css({top:cH, left: cW-jQuery('#asCont').width()-37});
		jQuery('body').append(asClose);
		
		document.getElementById('moveHandler').addEventListener('touchmove', function(event) {
		  // If there's exactly one finger inside this element
		  if (event.targetTouches.length == 1) {
			event.preventDefault();
			var touch = event.targetTouches[0];
			// Place element where the finger is
			document.getElementById('moveHandler').style.left = touch.pageX + 'px';
			document.getElementById('moveHandler').style.top = touch.pageY + 'px';
			jQuery('#asCont').css({top:parseFloat(jQuery('#moveHandler').css('top').slice(0, (jQuery('#moveHandler').css('top').length-2)))+18, left: jQuery('#moveHandler').offset().left+jQuery('#asClose').width()-17});
			jQuery('#asClose').css({top:jQuery('#asCont').offset().top-jQuery('#asClose').height(), left: jQuery('#asCont').offset().left+jQuery('#asCont').width()+jQuery('#asClose').width()/2});
		  }
		}, false);
		
		jQuery('#moveHandler').draggable({ cursor: "move" , drag: function( event, ui ) {
			jQuery('#asCont').css({top:parseFloat(jQuery('#moveHandler').css('top').slice(0, (jQuery('#moveHandler').css('top').length-2)))+18, left: jQuery('#moveHandler').offset().left+jQuery('#asClose').width()-17});
			jQuery('#asClose').css({top:jQuery('#asCont').offset().top-jQuery('#asClose').height(), left: jQuery('#asCont').offset().left+jQuery('#asCont').width()+jQuery('#asClose').width()/2});
		} , stop:function(){
			jQuery('#asCont').css({top:parseFloat(jQuery('#moveHandler').css('top').slice(0, (jQuery('#moveHandler').css('top').length-2)))+18, left: jQuery('#moveHandler').offset().left+jQuery('#asClose').width()-17});
			jQuery('#asClose').css({top:jQuery('#asCont').offset().top-jQuery('#asClose').height(), left: jQuery('#asCont').offset().left+jQuery('#asCont').width()+jQuery('#asClose').width()/2});
			
		}});
		
		if(jQuery.browser.msie) jQuery('#asBg').css('display','block');
		else jQuery('#asBg').fadeIn(300);
		jQuery(window).bind('resize',function(){
			var realW=jQuery(window).width();
			var realH=jQuery(window).height();
			if(setH&&setW){
				h=setH;
				w=setW;
				var asContH='-'+parseInt(h)*0.5+'px';
				var asContW='-'+parseInt(w)*0.5+'px';
				jQuery('#asCont').attr('style','width:'+w+'px; height:'+globalHeight+'px;');
				asCont.css({top:getWindowTop(),left:screenX()-jQuery('#asCont').width()*0.5}); 

				jQuery('#moveHandler').css({top:getWindowTop()-18, left: screenX()+parseInt(jQuery('#asCont').width())*0.5+21-jQuery('#asCont').width()-37});
				var cH=screenY()-parseInt(h)*0.5-18;
				var cW=screenX()+parseInt(w)*0.5+21;
				jQuery('#asClose').attr('style','top: '+cH+'px; left:'+cW+'px; outline: 0 none;')
			}
		});
		if(href===undefined) 
		{
			if(autoHeight==false) autoHeight=h;
			else autoHeight='auto';
			globalHeight=autoHeight;
			if(jQuery('#asCont .defaultFocus').length==0) jQuery('div#asCont').focus(); else jQuery('#asCont .defaultFocus:eq(0)').focus().each(function(){if(jQuery(this).hasClass('endStringFocus')) {this.selectionStart = this.selectionEnd = this.value.length; } });
			jQuery('div#asCont').css('height',globalHeight);
			jQuery('#asClose').click(function(){
				jQuery('#asClose').remove();
				jQuery('#moveHandler').remove();
				jQuery('#asCont').remove();
				jQuery('#asBg').remove();
				jQuery('body').removeAttr('style');
				//jQuery('body').attr('style','background:url(/img/santaseamless.png)'); //# New year background removeAttr('style') after new year
				setW=null;
				setH=null;
				autoHeight=null
				jQuery('body').unbind('keyup');
				jQuery('.defaultFocus').focus();
				if(currentPage!=undefined)
				{
					if(typeof(currentPage.hashCode)=='function') 
						createCookie('pagePosition_'+currentPage.hashCode(), jQuery(window).scrollTop());
				}
			});
			jQuery('body').keyup(function(e){
				if(e.keyCode=='27') jQuery('#asClose').click();
				if(e.keyCode=='13') jQuery('#asCont').find('.defaultAction').click();
				});
			if(isIpad==true)	
			{
				jQuery('#asCont input, #asCont textarea').focus(function(){
					jQuery(window).scrollTop(jQuery(window).scrollTop() + 34);
				});
				
				jQuery('#asCont input, #asCont textarea').blur(function(){
					jQuery(window).scrollTop(jQuery(window).scrollTop() - 34);
				});
			}	
			return;
		}
		if(data!=undefined && data!='' && data!=false && data!={} && data!=[]) var ajaxMethod='POST'; else ajaxMethod='GET';
		jQuery.ajax({type:ajaxMethod,url:href, data:data, success:function(html){
			jQuery('#asCont').html(html);
			if(autoHeight==false) autoHeight=h;
			else autoHeight='auto';
			globalHeight=autoHeight;
			if(jQuery('#asCont .defaultFocus').length==0) jQuery('div#asCont').focus(); else jQuery('#asCont .defaultFocus:eq(0)').focus().each(function(){if(jQuery(this).hasClass('endStringFocus')) {this.selectionStart = this.selectionEnd = this.value.length; } });
			jQuery('div#asCont').css('height',globalHeight);
			if(isIpad==true)	
			{
				jQuery('#asCont input, #asCont textarea').focus(function(){
					jQuery(window).scrollTop(jQuery(window).scrollTop() + 34);
				});
				
				jQuery('#asCont input, #asCont textarea').blur(function(){
					jQuery(window).scrollTop(jQuery(window).scrollTop() - 34);
				});
			}
			jQuery('#asClose').click(function(){
				jQuery('#asClose').remove();
				jQuery('#asCont').remove();
				jQuery('#moveHandler').remove();
				jQuery('#asBg').remove();
				jQuery('body').removeAttr('style');
				//jQuery('body').attr('style','background:url(/img/santaseamless.png)'); //# New year background removeAttr('style') after new year
				setW=null;
				setH=null;
				autoHeight=null
				jQuery('body').unbind('keyup');
				jQuery('.defaultFocus').focus();
				if(currentPage!=undefined)
				{
					if(typeof(currentPage.hashCode)=='function') 
						createCookie('pagePosition_'+currentPage.hashCode(), jQuery(window).scrollTop());
				}
			});
			jQuery('#asBg').click(function(){jQuery('#asClose').click();});
			jQuery('body').keyup(function(e){
				if(e.keyCode=='27') jQuery('#asClose').click();
				if(e.keyCode=='13') jQuery('#asCont').find('.defaultAction').click();
				});
		}, error: function(){jQuery('#asCont, #asClose, #asBg').remove();}
		});
	
};

function screenX(){
	return parseInt(window.getClientWidth()*0.5)+window.getBodyScrollLeft()
};
function screenY(){
	return parseInt(window.getClientHeight()*0.5)+window.getBodyScrollTop()
};
function getClientWidth(){
	return document.compatMode=='CSS1Compat'&&!window.opera?document.documentElement.clientWidth:document.body.clientWidth
};
function getClientHeight(){
	return document.compatMode=='CSS1Compat'&&!window.opera?document.documentElement.clientHeight:document.body.clientHeight
};
function getBodyScrollTop(){
	return self.pageYOffset||(document.documentElement&&document.documentElement.scrollTop)||(document.body&&document.body.scrollTop)
};
function getBodyScrollLeft(){
	return self.pageXOffset||(document.documentElement&&document.documentElement.scrollLeft)||(document.body&&document.body.scrollLeft)
};



jQuery('.quickMenuButton').live('click', function(e) {
			
				e.stopPropagation();
				
				var pTop=e.pageY+10;
				var pLeft=e.pageX+10;
				e.preventDefault();
				jQuery('.bill_menu').hide();
				
				var billId=jQuery(this).attr('id').replace('edit_','');					
				var href=jQuery(this).attr('href');
				var billlink=jQuery(this)[0];
				if(billlink.popup==undefined)
				{					
					var result=sendAJAX('get', href);
					var popup=jQuery(result);
					
					jQuery(popup).click(function(e){
						e.stopPropagation();
						if(e.target.localName!='input' && e.target.localName!='label')
							e.preventDefault();
					}).css({top:pTop});
					
					jQuery(popup).find('a:not(.menuClose)').click(function(e){
						e.preventDefault();						
						if(jQuery(this).hasClass('editBtn'))
						{
							jQuery(this).parents('.bill_menu:eq(0)').hide();
							window.open(jQuery(this).attr('href'), '{#bills_buttons_edit#} {#bill_list_invioce#} '+billId);
						}
						else if(jQuery(this).hasClass('deleteBtn'))
						{
							var href=jQuery(this).attr('href');
							aslobodyanMessage(true,'{#bills_buttons_delete#}?', [], function(){
								jQuery('#messCont').click(function(e){e.stopPropagation();});
								jQuery('#messYes').one('click',function(){
									jQuery('#messCont').remove();
									var responce=sendAJAX('post', href, "json");
								
									if(responce.code==1)
									{
										fnReloadPage();
									}
								});
							});														
							billlink.popup=undefined;
						}
						else
						{
							var data={};
							if(jQuery(this).hasClass('payBtn')) 
							{
								data.form={};
								if(jQuery(this).parents('table:eq(0)').find('.saveAsCompleted').length!=0 && jQuery(this).parents('table:eq(0)').find('.saveAsCompleted').attr('checked')=='checked')
								data.form.saveAsCompleted=1;
								data.form.sum=jQuery(this).parents('table:eq(0)').find('.paySum').val();
								data.form.completingDate=jQuery(this).parents('table:eq(0)').find('.payDate').val();
							}
							else if(jQuery(this).hasClass('deliverBtn')) 
							{
								data.form={};
								data.form.completingDate=jQuery(this).parents('table:eq(0)').find('.date').val();
							}
							
							var href=jQuery(this).attr('href');
							var responce=sendAJAX('post', href, "json", data);
							
							if(responce.code==1)
							{
								fnReloadPage();
							}
							jQuery(this).parents('.bill_menu:eq(0)').hide();
							billlink.popup=undefined;
						}						
					}); 
					jQuery(popup).find('.payDate, .date').datepicker({beforeShow:function(){jQuery('#ui-datepicker-div').click(function(e){e.stopPropagation();});}});
					jQuery(popup).find('a.menuClose').click(function(e){e.preventDefault();	jQuery(popup).hide();});
					
					billlink.popup=popup;
					jQuery(billlink.popup).appendTo('body');
					if(pLeft+jQuery(popup).width()>=jQuery(window).width())
						jQuery(billlink.popup).css('right',0);
					else jQuery(billlink.popup).css('left',pLeft);
					
					
					jQuery(billlink.popup).show();
				}
				else {	
					jQuery(billlink.popup).css({top:pTop}).show();
					if(pLeft+jQuery(billlink.popup).width()>=jQuery(window).width())
						jQuery(billlink.popup).css('right',0);
					else jQuery(billlink.popup).css('left',pLeft);					
				}
	
});

